# Copy to deploy/bottle-at-sea.env (Docker) or /etc/bottle-at-sea.env (systemd) and fill in.

# Required. Any long random string, e.g. `openssl rand -hex 32`. Salts the daily IP hash used by the rate limiter.
SALT_SECRET=

# Where the "Buy me a coffee" button points. Leave empty to hide the button.
COFFEE_URL=

# Email replies (optional). Pick ONE transport; without either, replies are kept as notes on the bottle.
MAIL_FROM=
SMTP_URL=
RESEND_API_KEY=

# Behind nginx / Caddy (recommended): read the visitor address from X-Forwarded-For.
TRUST_PROXY=1

# systemd only (the Docker image sets these itself):
# NODE_ENV=production
# PORT=8787
# DB_PATH=/var/lib/bottle-at-sea/bottles.db
